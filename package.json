{
  "name": "claude-tools",
  "groupId": "com.codercowboy",
  "version": "1.0.0",
  "description": "A collection of small, single-file, vanilla-JS web tools. Each tool under src/tools/ ships an index.html that opens straight from file:// with no build step and no runtime dependencies; the dev/test dependencies (Playwright and friends) install once at the repo root.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Claude (Anthropic) <noreply@anthropic.com>",
  "contributors": [
    "Jason Baker <jason@onejasonforsale.com> (https://github.com/codercowboy)"
  ],
  "homepage": "https://github.com/codercowboy/claude-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codercowboy/claude-tools.git"
  },
  "bugs": {
    "url": "https://github.com/codercowboy/claude-tools/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-all.mjs",
    "build:check": "node scripts/build-all.mjs --check",
    "dist": "node scripts/build-all.mjs && node scripts/dist.mjs",
    "test:lib": "node --test src/lib/tests/",
    "test:all": "node scripts/test-all.mjs",
    "serve": "node scripts/serve.mjs src"
  },
  "bin": {
    "ct": "scripts/ct.mjs"
  },
  "keywords": [
    "web-tools",
    "developer-tools",
    "designer-tools",
    "vanilla-js",
    "no-dependencies",
    "zero-dependency",
    "single-file",
    "offline",
    "client-side",
    "browser",
    "qr-code",
    "base64",
    "color-picker",
    "color-converter",
    "color-designer",
    "uuid",
    "cron",
    "cidr",
    "subnet",
    "inflation-calculator",
    "utilities",
    "tools"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@codercowboy/claude-tpm": "file:../../tpm-workspace/claude-tpm-0.1.0",
    "jason-code": "file:../../jason-code"
  }
}
